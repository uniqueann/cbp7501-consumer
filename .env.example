# ── RabbitMQ 连接 ─────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# ── 队列名（代码自动声明为 durable）──────────────────────────────────────────
# 接收任务的队列，消息格式：{"ID": 1, "URL": "https://...7501.pdf", "CbpFormType": 10}
#   CbpFormType：10 美国 7501（文字层）/ 15 美国 7501（截图 OCR）
#                20 加拿大 BSF864（文字层）/ 25 加拿大 BSF864（截图 OCR）
INPUT_QUEUE=cbp7501.parse.request

# 发送解析结果的队列
#   成功：{"ID": 1, "status": "ok", "CbpFormType": 10, "us_data": {...}}
#         {"ID": 1, "status": "ok", "CbpFormType": 15, "us_data": {...}}
#         {"ID": 1, "status": "ok", "CbpFormType": 20, "ca_data": {...}}
#         {"ID": 1, "status": "ok", "CbpFormType": 25, "ca_data": {...}}
#   失败：{"ID": 1, "status": "error", "message": "..."}
OUTPUT_QUEUE=cbp7501.parse.result

# 同时处理的并发消息数（建议 = CPU 核数）
PREFETCH_COUNT=4
