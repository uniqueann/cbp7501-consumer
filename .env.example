# ── RabbitMQ 连接 ─────────────────────────────────────────────────────────────
RABBITMQ_HOST=localhost
RABBITMQ_PORT=5672
RABBITMQ_USER=guest
RABBITMQ_PASS=guest
RABBITMQ_VHOST=/

# ── 队列名（代码自动声明为 durable）──────────────────────────────────────────
# 接收任务的队列，消息格式：{"ID": 1, "URL": "https://...7501.pdf"}
INPUT_QUEUE=cbp7501.parse.request

# 发送解析结果的队列，消息格式：{"ID": 1, "status": "ok", "data": {...}}
OUTPUT_QUEUE=cbp7501.parse.result

# 同时处理的并发消息数（建议 = CPU 核数）
PREFETCH_COUNT=4
